// Daniel Cutting Tracker — Prisma schema
//
// Provider choice: SQLite is used for local development and the automated
// test suite because it requires no external service and keeps the whole
// system runnable inside a sandboxed environment with zero setup. The schema
// intentionally avoids SQLite-only features (no native enums, no arrays) so
// switching `provider` to "postgresql" and pointing DATABASE_URL at a
// Supabase/Postgres instance is a drop-in change for production. Enum-like
// fields are plain `String` validated at the application boundary with Zod
// (see src/lib/validation) instead of Prisma `enum`, since enum support is
// inconsistent across the two providers.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile            Profile?
  nutritionPlans     NutritionPlan[]
  mealEntries        MealEntry[]
  physicalActivities PhysicalActivity[]
  dailyLogs          DailyLog[]
  weightEntries      WeightEntry[]
  waterEntries       WaterEntry[]
  supplementEntries  SupplementEntry[]
  adjustmentLogs     AdjustmentLog[]
}

// Editable profile / biometric reference data. Never treated as ground
// truth by calculations — see calculateEstimatedEnergyBalance().
model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name    String
  sex     String // "male" | "female"
  birthDate DateTime
  heightCm  Float

  referenceWeightKg Float
  referenceWeightAt DateTime

  // Bioimpedance reference snapshot — editable, treated as an estimate.
  bodyFatPercent      Float?
  fatMassKg           Float?
  muscleMassKg        Float?
  skeletalMuscleKg    Float?
  visceralFat         Float?
  bmi                 Float?
  deviceBmrKcal       Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One food item and its nutrition facts per 100g, plus a default serving.
model Food {
  id                String @id @default(cuid())
  name              String
  category          String
  servingUnit       String // "g" | "unit" | "slice" | "tbsp" | "cup" | "ml"
  gramsPerUnit      Float? // required when servingUnit != "g"/"ml"
  caloriesPer100g   Float
  proteinPer100g    Float
  carbsPer100g      Float
  fatPer100g        Float
  fiberPer100g      Float
  source            String @default("manual")
  verified          Boolean @default(false)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  mealEntries   MealEntry[]
  planMealItems PlanMealItem[]

  @@index([name])
}

// A weekly (or arbitrary period) nutrition plan — "Week 1", "Week 2", ...
model NutritionPlan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String // e.g. "Semana 3"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)

  caloriesMin    Float
  caloriesTarget Float
  caloriesMax    Float

  proteinMin    Float
  proteinTarget Float
  proteinMax    Float

  carbsMin    Float
  carbsTarget Float
  carbsMax    Float

  fatMin    Float
  fatTarget Float
  fatMax    Float

  fiberMin Float
  fiberMax Float

  waterMinMl Float
  waterMaxMl Float

  creatineTargetG Float @default(5)
  wheyTargetG     Float @default(40)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meals PlanMeal[]

  @@index([userId, startDate, endDate])
}

// A meal slot inside a plan (breakfast, lunch, shake, dinner, ...).
model PlanMeal {
  id     String        @id @default(cuid())
  planId String
  plan   NutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  mealType String // breakfast | morning_snack | lunch | afternoon_snack | dinner | supper | other
  name     String
  order    Int

  // Permanent-rule flag: true for the Daniel shake meal, meaning the
  // adjustment engine may resize items but must never remove the
  // mandatory categories (fruit, milk, whey, oats, nuts, creatine).
  isProtectedComposition Boolean @default(false)

  items PlanMealItem[]

  @@index([planId])
}

// One food target inside a plan meal, with adjustment bounds used by the
// "least change" optimizer (see src/lib/adjustment).
model PlanMealItem {
  id         String   @id @default(cuid())
  planMealId String
  planMeal   PlanMeal @relation(fields: [planMealId], references: [id], onDelete: Cascade)
  foodId     String
  food       Food     @relation(fields: [foodId], references: [id])

  targetQuantityG Float
  minQuantityG    Float
  maxQuantityG    Float
  adjustmentStepG Float @default(10)

  // Nutrient role drives which items the adjustment engine prefers to
  // move first (protein sources vs. carb/fat sources).
  role String // protein | carb | fat | fixed

  // Mandatory items (e.g. whey/creatine in the shake) can be resized but
  // never zeroed out by the optimizer.
  isMandatory Boolean @default(false)

  @@index([planMealId])
}

// A logged food item, exactly as consumed. Immutable once meals in the
// past are never auto-modified (see src/lib/adjustment).
model MealEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date     DateTime // day this entry belongs to (local date, time zeroed)
  mealType String

  foodId String?
  food   Food?   @relation(fields: [foodId], references: [id])

  freeTextDescription String? // used when no matching Food row exists yet

  quantity Float
  unit     String
  grams    Float

  calories Float
  protein  Float
  carbs    Float
  fat      Float
  fiber    Float

  source      String  @default("user") // user | ai_parser | plan
  isEstimated Boolean @default(false)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model PhysicalActivity {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date         DateTime
  activityType String // steps | weight_training | swimming | walking | running | cycling | cardio | sports | other

  description      String?
  durationMinutes  Float?
  steps            Int?
  caloriesBurned   Float
  caloriesSource   String  @default("user") // user | device | estimated
  intensity        String?
  distanceKm       Float?

  // Prevents double counting: e.g. if a walking session already embeds a
  // step count that is separately logged as a "steps" activity.
  includedInActivityTotal Boolean @default(true)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

// Daily snapshot/summary. Detailed data stays in MealEntry /
// PhysicalActivity; this table is a denormalized cache for fast dashboard
// reads and for fields that don't belong anywhere else (hunger, energy...).
model DailyLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date DateTime

  weightKg Float?

  totalActivityCaloriesKcal Float @default(0)
  estimatedBmrKcal          Float @default(0)
  estimatedTdeeKcal         Float @default(0)

  caloriesConsumedKcal Float @default(0)
  proteinConsumedG     Float @default(0)
  carbsConsumedG       Float @default(0)
  fatConsumedG         Float @default(0)
  fiberConsumedG       Float @default(0)

  waterMl Float @default(0)

  hunger              Int? // 1-5 subjective scale
  energy              Int? // 1-5 subjective scale
  trainingPerformance Int? // 1-5 subjective scale

  dayStatus String @default("on_track") // on_track | above_target | below_target

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model WeightEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date                  DateTime
  time                  String?
  weightKg              Float
  measurementCondition  String? // e.g. "fasted_on_waking"
  notes                 String?

  createdAt DateTime @default(now())

  @@index([userId, date])
}

model WaterEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date     DateTime
  amountMl Float
  notes    String?

  createdAt DateTime @default(now())

  @@index([userId, date])
}

model SupplementEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date          DateTime
  type          String // whey | creatine | other
  targetGrams   Float
  takenGrams    Float?
  taken         Boolean @default(false)
  notes         String?

  createdAt DateTime @default(now())

  @@index([userId, date])
  @@unique([userId, date, type])
}

// Audit trail every time the adjustment engine recalculates future meals.
model AdjustmentLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date              DateTime
  triggerMealEntryId String?
  reason            String
  originalPlanJson  String // JSON snapshot of affected PlanMealItem quantities before
  adjustedPlanJson  String // JSON snapshot after
  changesJson       String // JSON list of {food, before, after, unit}
  warningsJson      String? // JSON list of warning strings

  createdAt DateTime @default(now())

  @@index([userId, date])
}
